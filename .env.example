# NetQuiz Backend Environment Configuration Example
# Copy to .env for local overrides if needed. In cloud platforms like Render,
# these are set in the service dashboard's Environment tab.

# FastAPI Web Bridge Port (Render provides $PORT automatically)
PORT=8000
FASTAPI_HOST=0.0.0.0

# Deployed Frontend URL(s) for CORS (comma-separated if multiple)
# e.g.: FRONTEND_URL=https://netquiz-frontend.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Python TCP Socket Server Internal Port & Interface
TCP_SERVER_PORT=5000
TCP_SERVER_HOST=127.0.0.1
